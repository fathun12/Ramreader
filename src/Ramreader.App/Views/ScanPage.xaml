<Page x:Class="Ramreader.App.Views.ScanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Cari Nilai"
      Style="{StaticResource AppPage}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Bagian atas: tetap di tempat -->
        <StackPanel Grid.Row="0">
            <StackPanel Margin="0,0,0,16">
                <ui:TextBlock Text="Cari Nilai" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Cari alamat memori yang menyimpan nilai di game, misalnya HP atau uang."
                           Margin="0,6,0,0"
                           Style="{StaticResource MutedText}" />
            </StackPanel>

            <ui:InfoBar Margin="0,0,0,12"
                        Severity="Warning"
                        Title="Belum terhubung"
                        Message="Hubungkan ke game dulu di menu Proses."
                        IsOpen="{Binding NotConnected, Mode=OneWay}"
                        IsClosable="False" />

            <ui:InfoBar Margin="0,0,0,12"
                        Severity="Informational"
                        Title="Info"
                        Message="{Binding Message}"
                        IsOpen="{Binding HasMessage, Mode=OneWay}"
                        IsClosable="False" />

            <!-- Kartu kontrol scan -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tipe nilai" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding TypeOptions}"
                                      SelectedItem="{Binding SelectedType}"
                                      DisplayMemberPath="Label"
                                      IsEnabled="{Binding CanChangeType}" />
                        </StackPanel>

                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nilai" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox PlaceholderText="Contoh: 100"
                                            Text="{Binding ValueInput, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sampai (rentang)" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox PlaceholderText="Batas atas"
                                            Text="{Binding ValueMaxInput, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Mode scan lanjutan" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding ModeOptions}"
                                      SelectedItem="{Binding SelectedMode}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                    </Grid>

                    <!-- Semua tombol dalam satu baris -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:Button Content="Scan Pertama"
                                       Appearance="Primary"
                                       Command="{Binding FirstScanCommand}" />
                            <ui:Button Content="Ambil Snapshot"
                                       Margin="8,0,0,0"
                                       ToolTip="Untuk nilai yang tidak tampil sebagai angka (misalnya bar HP). Tidak perlu mengetik nilai."
                                       Command="{Binding SnapshotCommand}" />
                            <ui:Button Content="Scan Rentang"
                                       Margin="8,0,0,0"
                                       ToolTip="Cari nilai di antara batas bawah (kolom Nilai) dan batas atas (kolom Sampai)."
                                       Command="{Binding RangeScanCommand}" />
                            <ui:Button Content="Scan Lanjutan"
                                       Margin="8,0,0,0"
                                       Command="{Binding NextScanCommand}" />
                            <ui:Button Content="Reset"
                                       Margin="8,0,0,0"
                                       Command="{Binding ResetCommand}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="Salin Alamat"
                                       Command="{Binding CopyAddressCommand}" />
                            <ui:Button Content="Jadikan Target"
                                       Margin="8,0,0,0"
                                       Appearance="Primary"
                                       Command="{Binding SetTargetCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Hint}"
                               Margin="0,12,0,0"
                               Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>

            <!-- Progres + ringkasan -->
            <StackPanel Margin="0,0,0,8">
                <ProgressBar Minimum="0"
                             Maximum="1"
                             Height="4"
                             Margin="0,0,0,8"
                             Value="{Binding ScanProgress, Mode=OneWay}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="{Binding ResultSummary}"
                               Style="{StaticResource MutedText}" />

                    <ui:Button Grid.Column="1"
                               Content="Batal"
                               Command="{Binding CancelCommand}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </StackPanel>

            <!-- Judul kolom -->
            <Grid Margin="16,4,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Alamat" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="1" Text="Nilai" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="2" Text="Sebelumnya" Style="{StaticResource ColumnHeader}" />
            </Grid>
        </StackPanel>

        <!-- Hanya daftar hasil yang digulir -->
        <ui:ListView Grid.Row="1"
                     ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding SelectedRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding AddressText}"
                                   FontFamily="Consolas" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ValueText}"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding PreviousText}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>
    </Grid>
</Page>