<Page x:Class="Ramreader.App.Views.PointerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Jalur Stabil"
      Style="{StaticResource AppPage}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Bagian atas: tetap di tempat -->
        <StackPanel Grid.Row="0">
            <StackPanel Margin="0,0,0,16">
                <ui:TextBlock Text="Jalur Stabil" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Cari jalur pointer yang tetap benar setelah game direstart."
                           Margin="0,6,0,0"
                           Style="{StaticResource MutedText}" />
            </StackPanel>

            <ui:InfoBar Margin="0,0,0,12"
                        Severity="Warning"
                        Title="Belum terhubung"
                        Message="Hubungkan ke game dulu di menu Proses."
                        IsOpen="{Binding NotConnected, Mode=OneWay}"
                        IsClosable="False" />

            <ui:InfoBar Margin="0,0,0,12"
                        Severity="Warning"
                        Title="Belum ada target"
                        Message="Di menu Cari Nilai, pilih satu alamat lalu klik Jadikan Target."
                        IsOpen="{Binding ShowNoTarget, Mode=OneWay}"
                        IsClosable="False" />

            <ui:InfoBar Margin="0,0,0,12"
                        Severity="Informational"
                        Title="Info"
                        Message="{Binding Message}"
                        IsOpen="{Binding HasMessage, Mode=OneWay}"
                        IsClosable="False" />

            <!-- Kartu kontrol -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding TargetText}"
                               FontFamily="Consolas"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Kedalaman pencarian" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding DepthOptions}"
                                      SelectedItem="{Binding SelectedDepth}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Jarak offset maksimum" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding OffsetOptions}"
                                      SelectedItem="{Binding SelectedOffset}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>
                    </Grid>

                    <!-- Semua tombol dalam satu baris -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:Button Content="Cari Jalur"
                                       Appearance="Primary"
                                       Command="{Binding FindCommand}" />
                            <ui:Button Content="Verifikasi"
                                       Margin="8,0,0,0"
                                       Command="{Binding VerifyCommand}" />
                            <ui:Button Content="Hapus Kandidat"
                                       Margin="8,0,0,0"
                                       Command="{Binding ClearCommand}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="Salin Jalur"
                                       Command="{Binding CopyChainCommand}" />
                            <ui:Button Content="Simpan Alamat"
                                       Margin="8,0,0,0"
                                       Appearance="Primary"
                                       Command="{Binding OpenSaveCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Hint}"
                               Margin="0,12,0,0"
                               Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>

            <!-- Kotak kecil: label untuk alamat yang disimpan -->
            <Border Style="{StaticResource CardBorder}"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Label alamat ini" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox PlaceholderText="Contoh: Tiket"
                                    Text="{Binding SaveLabel, UpdateSourceTrigger=PropertyChanged}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ConfirmSaveCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Bottom"
                               Appearance="Primary"
                               Content="Simpan"
                               Command="{Binding ConfirmSaveCommand}" />
                    <ui:Button Grid.Column="2"
                               Margin="8,0,0,0"
                               VerticalAlignment="Bottom"
                               Content="Batal"
                               Command="{Binding CancelSaveCommand}" />
                </Grid>
            </Border>

            <!-- Progres + ringkasan -->
            <StackPanel Margin="0,0,0,8">
                <ProgressBar Minimum="0"
                             Maximum="1"
                             Height="4"
                             Margin="0,0,0,8"
                             Value="{Binding ScanProgress, Mode=OneWay}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" />
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                               Content="Batal"
                               Command="{Binding CancelCommand}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </StackPanel>

            <!-- Judul kolom -->
            <Grid Margin="16,4,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Jalur" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="1" Text="Panjang" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="2" Text="Alamat sekarang" Style="{StaticResource ColumnHeader}" />
            </Grid>
        </StackPanel>

        <!-- Hanya daftar jalur yang digulir -->
        <ui:ListView Grid.Row="1"
                     ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding SelectedRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Description}"
                                   FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LevelText}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ResolvedText}"
                                   FontFamily="Consolas" />
                    </Grid>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>
    </Grid>
</Page>