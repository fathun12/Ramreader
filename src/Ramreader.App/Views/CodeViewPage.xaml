<Page x:Class="Ramreader.App.Views.CodeViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Lihat Kode"
      Style="{StaticResource AppPage}">

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Margin="0,0,0,12">
                <ui:TextBlock Text="Lihat Kode" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Membongkar instruksi game di sekitar satu lokasi, tanpa Cheat Engine. Hanya membaca memori."
                           Margin="0,6,0,0"
                           Style="{StaticResource MutedText}" />
            </StackPanel>

            <ui:InfoBar Margin="0,0,0,8"
                        Severity="Warning"
                        Title="Belum terhubung"
                        Message="Hubungkan ke game dulu di menu Proses."
                        IsOpen="{Binding NotConnected, Mode=OneWay}"
                        IsClosable="False" />

            <ui:InfoBar Margin="0,0,0,8"
                        Severity="Informational"
                        Title="Info"
                        Message="{Binding Message}"
                        IsOpen="{Binding HasMessage, Mode=OneWay}"
                        IsClosable="False" />

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Lokasi (offset hex dari exe)" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Byte sebelum" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding BeforeText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Byte sesudah" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding AfterText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button Content="Tampilkan" Margin="0,0,8,6" Appearance="Primary"
                                   Command="{Binding ShowCommand}" />
                        <ui:Button Content="Salin" Margin="0,0,8,6"
                                   Command="{Binding CopyCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBox Grid.Row="1"
                 Text="{Binding Output, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 FontSize="12"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto" />
    </Grid>
</Page>