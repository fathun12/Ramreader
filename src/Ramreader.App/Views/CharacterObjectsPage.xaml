<Page x:Class="Ramreader.App.Views.CharacterObjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Objek Karakter"
      Style="{StaticResource AppPage}">

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Margin="0,0,0,12">
                <ui:TextBlock Text="Objek Karakter" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Cari penanda sisi/tim di dalam objek karakter, supaya satu patch berlaku untuk seluruh timmu."
                           Margin="0,6,0,0"
                           Style="{StaticResource MutedText}" />
            </StackPanel>

            <ui:InfoBar Margin="0,0,0,8"
                        Severity="Warning"
                        Title="Belum terhubung"
                        Message="Hubungkan ke game dulu di menu Proses."
                        IsOpen="{Binding NotConnected, Mode=OneWay}"
                        IsClosable="False" />

            <ui:InfoBar Margin="0,0,0,8"
                        Severity="Warning"
                        Title="Belum ada alamat tersimpan"
                        Message="Simpan dulu alamat di menu Jalur Stabil (tombol Simpan Alamat)."
                        IsOpen="{Binding ShowNoSaved, Mode=OneWay}"
                        IsClosable="False" />

            <ui:InfoBar Margin="0,0,0,8"
                        Severity="Informational"
                        Title="Info"
                        Message="{Binding Message}"
                        IsOpen="{Binding HasMessage, Mode=OneWay}"
                        IsClosable="False" />

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Alamat tersimpan (untuk mengenali objek milikmu)" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Saved.Items}"
                                      SelectedItem="{Binding SelectedSaved}"
                                      DisplayMemberPath="Label" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Instruksi (offset hex dari exe)" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding InstructionText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button Content="Mulai Pantau" Margin="0,0,8,6" Appearance="Primary"
                                   Command="{Binding StartCommand}" />
                        <ui:Button Content="Berhenti" Margin="0,0,8,6"
                                   Command="{Binding StopCommand}" />
                        <ui:Button Content="Tandai Tim" Margin="0,0,8,6"
                                   Command="{Binding MarkTeamCommand}" />
                        <ui:Button Content="Tandai Musuh" Margin="0,0,8,6"
                                   Command="{Binding MarkEnemyCommand}" />
                        <ui:Button Content="Sisanya Musuh" Margin="0,0,8,6"
                                   Command="{Binding MarkRestEnemyCommand}" />
                        <ui:Button Content="Tandai Otomatis" Margin="0,0,8,6" Appearance="Primary"
                                   Command="{Binding AutoMarkCommand}" />
                        <ui:Button Content="Hapus Tanda" Margin="0,0,8,6"
                                   Command="{Binding ClearMarksCommand}" />
                        <ui:Button Content="Bandingkan" Margin="0,0,8,6" Appearance="Primary"
                                   Command="{Binding CompareCommand}" />
                        <ui:Button Content="Ulangi Irisan" Margin="0,0,8,6"
                                   Command="{Binding ResetRoundsCommand}" />
                    </WrapPanel>

                    <TextBlock Text="{Binding Hint}" Margin="0,2,0,0" Style="{StaticResource MutedText}" />
                    <TextBlock Text="Selama Mulai Pantau berjalan, Ramreader menempel ke game sebagai debugger. Jangan dipakai pada game dengan anti-cheat atau game online. Matikan patch di Trainer dulu."
                               Margin="0,8,0,0" FontSize="12" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Summary}" Margin="0,0,0,4" Style="{StaticResource MutedText}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="16,4,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Objek (basis)" Style="{StaticResource ColumnHeader}" />
            <TextBlock Grid.Column="1" Text="Peran" Style="{StaticResource ColumnHeader}" />
            <TextBlock Grid.Column="2" Text="Hit" Style="{StaticResource ColumnHeader}" />
            <TextBlock Grid.Column="3" Text="Nilai" Style="{StaticResource ColumnHeader}" />
        </Grid>

        <ui:ListView Grid.Row="2"
                     ItemsSource="{Binding Objects}"
                     SelectedItem="{Binding SelectedObject}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding BaseText}" FontFamily="Consolas" />
                        <TextBlock Grid.Column="1" Text="{Binding RoleText}" />
                        <TextBlock Grid.Column="2" Text="{Binding Hits}" />
                        <TextBlock Grid.Column="3" Text="{Binding ValueText}" FontFamily="Consolas" />
                    </Grid>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding CandidateSummary}" Margin="0,0,0,6" Style="{StaticResource MutedText}" />
            <Grid Margin="16,0,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Offset" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="1" Text="Nilai Tim" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="2" Text="Nilai Musuh" Style="{StaticResource ColumnHeader}" />
            </Grid>
        </StackPanel>

        <ui:ListView Grid.Row="4"
                     ItemsSource="{Binding Candidates}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding OffsetText}" FontFamily="Consolas" />
                        <TextBlock Grid.Column="1" Text="{Binding TeamText}" FontFamily="Consolas" />
                        <TextBlock Grid.Column="2" Text="{Binding EnemyText}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>
    </Grid>
</Page>