<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Semua tampilan Ramreader diatur di file ini. Ubah di sini, semua halaman ikut berubah. -->

    <!-- Halaman: warna teks dasar + hanya daftar yang digulir -->
    <Style x:Key="AppPage" TargetType="Page">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- Kotak isi halaman: jarak ke tepi jendela -->
    <Style x:Key="PageRoot" TargetType="Grid">
        <Setter Property="Margin" Value="32,24,32,16" />
    </Style>

    <!-- Judul halaman -->
    <Style x:Key="PageTitle" TargetType="ui:TextBlock">
        <Setter Property="FontTypography" Value="Title" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Kartu: latar, garis tipis, sudut membulat -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <!-- Label kecil di atas kolom isian -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Judul kolom daftar -->
    <Style x:Key="ColumnHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- Teks petunjuk / keterangan -->
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
</ResourceDictionary>